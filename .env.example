# Copy to .env and fill in. Generate keys with: python scripts/new_key.py <label>
# Three keys on start: claude-code (server), laptop, claudeai (phone) — see design §8.
API_KEYS=

# Secret(s) for the Claude.ai MCP connector, which can't send an auth header.
# Same label:sha256 format as API_KEYS; the connector URL is then
# https://transcribe.<YOUR-HOST>.net/mcp/k/<secret>. Leave empty to disable.
MCP_URL_SECRETS=

PUBLIC_BASE_URL=https://transcribe.<YOUR-HOST>.net

# Paths (inside the container these map to the /data and /models volumes)
DATA_DIR=/data
MODELS_DIR=/models

# ASR / pipeline defaults
DEFAULT_LANGUAGE=en
DEFAULT_MODEL=large-v3-turbo
DEFAULT_DIARIZATION=pyannote
CPU_THREADS=3

# Limits
MAX_UPLOAD_MB=2048
MAX_DURATION_MIN=240
PART_TOKENS=15000
PAUSE_SPLIT_S=2
UPLOAD_LINK_TTL_S=3600

# Only needed by scripts/download_models.py to fetch gated pyannote models.
HF_TOKEN=
PYANNOTE_PIPELINE=pyannote/speaker-diarization-community-1
SHERPA_CLUSTER_THRESHOLD=0.5
